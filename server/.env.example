# ===================================================
# Foluxe Server Environment Configuration (.env)
# ===================================================

# Port for the Express server to listen on
PORT=5000

# MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/foluxe
# MongoDB Atlas (Cloud) Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/foluxe?retryWrites=true&w=majority

# Secret key used for signing JWT tokens (use a random, secure string)
JWT_SECRET=foluxe_super_secret_jwt_key_2026_change_this

# Initial Administrator Credentials (seeded into DB if no admin exists)
ADMIN_EMAIL=admin@foluxe.com
ADMIN_PASSWORD=FoluxeAdmin2026!Secure

# Cloudinary Configuration (Used for product image uploads in /admin/products)
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
